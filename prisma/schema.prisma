// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

enum Sex {
  MALE
  FEMALE
}

enum BodyType {
  ECTOMORPH
  MESOMORPH
  ENDOMORPH
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  MAINTENANCE
  DEFICIT
  SURPLUS
}

enum BmrFormula {
  AUTO
  MIFFLIN
  HARRIS_BENEDICT
  KATCH_MCARDLE
}

enum ActivityMode {
  SIMPLE
  DETAILED
}

enum JobActivity {
  SEDENTARY
  LIGHT
  MODERATE
  HEAVY
}

enum WorkoutType {
  WALKING
  RUNNING
  CYCLING
  STRENGTH
  HIIT
  SWIMMING
  OTHER
}

enum PhysiologicalState {
  NONE
  PREGNANT_T1
  PREGNANT_T2
  PREGNANT_T3
  LACTATING
}

enum ThyroidCondition {
  NONE
  HYPOTHYROID
  HYPERTHYROID
}

enum MacroPreset {
  BALANCED
  HIGH_PROTEIN
  LOW_CARB
  CUSTOM
}

enum Climate {
  TEMPERATE
  HOT
  COLD
}

enum StressLevel {
  LOW
  MODERATE
  HIGH
}

enum ServingUnit {
  GRAMS_100
  UNIT
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  EXTRA
}

enum FoodType {
  CARBOHIDRATOS
  GRASAS
  PROTEINAS
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  foods         Food[]
  mealTemplates MealTemplate[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Profile {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String        @unique
  name          String
  sex           Sex
  age           Int
  heightCm      Float
  weightKg      Float
  bodyType      BodyType
  activityLevel ActivityLevel
  goal          Goal
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  entries       FoodEntry[]
  weightLogs    WeightLog[]
  changes       ProfileChange[]

  // Composición corporal (opcional)
  bodyFatPct Float?
  neckCm     Float?
  waistCm    Float?
  hipCm      Float?

  // Fórmula de metabolismo basal
  bmrFormula            BmrFormula @default(AUTO)
  useBodyTypeAdjustment Boolean    @default(true)

  // Objetivo
  adjustmentPct  Float?
  weeklyRateKg   Float?
  targetWeightKg Float?

  // Actividad
  activityMode    ActivityMode @default(SIMPLE)
  jobActivity     JobActivity  @default(SEDENTARY)
  dailySteps      Int?
  workoutsPerWeek Int?
  workoutMinutes  Int?
  workoutType     WorkoutType  @default(STRENGTH)

  // Deportes que practica, aparte del entrenamiento regular. No suman a la meta base:
  // se suman el día que se marcan. JSON: [{ "sport": "FOOTBALL", "minutes": 60, "perWeek": 2 }]
  // (ver lib/sports.ts)
  sports String @default("[]")

  // Condiciones fisiológicas
  physiologicalState PhysiologicalState @default(NONE)
  thyroidCondition   ThyroidCondition   @default(NONE)

  // Macronutrientes
  macroPreset  MacroPreset @default(BALANCED)
  proteinPerKg Float?

  // Estilo de vida
  sleepHours  Float?
  stressLevel StressLevel?
  climate     Climate      @default(TEMPERATE)

  // Ajuste dinámico según el peso real
  adaptiveTdee Boolean @default(false)

  // Preferencia: mostrar el gráfico de evolución del peso en Estadísticas.
  showWeightChart Boolean @default(false)

  // Suplementos que toma a diario. JSON: ["CREATINE", "OMEGA_3", ...] (ver lib/supplements.ts)
  supplements String @default("[]")

  dailyLogs DailyLog[]
}

// Historial de cambios del perfil: qué cambió, por qué y cómo movió las calorías.
model ProfileChange {
  id                 String   @id @default(cuid())
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId          String
  // CREATED | EDIT | WEIGHT
  source             String
  note               String?
  // JSON: [{ field, label, from, to }]
  changes            String
  goalBefore         Int?
  goalAfter          Int
  maintenanceBefore  Int?
  maintenanceAfter   Int
  createdAt          DateTime @default(now())

  @@index([profileId, createdAt])
}

model WeightLog {
  id        String   @id @default(cuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  date      String
  weightKg  Float
  createdAt DateTime @default(now())

  @@unique([profileId, date])
  @@index([profileId, date])
}

// Seguimiento diario de hidratación y suplementos (una fila por perfil y día).
model DailyLog {
  id                 String   @id @default(cuid())
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId          String
  date               String
  waterMl            Int      @default(0)
  // Meta de agua vigente al registrar el día, para que el historial no cambie si cambia el perfil.
  waterGoalMl        Int
  // JSON: suplementos del perfil al registrar el día y los que se marcaron como tomados.
  supplementsPlanned String   @default("[]")
  supplementsTaken   String   @default("[]")
  // JSON: deportes hechos ese día con las kcal sumadas a la meta, ya ajustadas según el objetivo.
  // [{ "sport": "FOOTBALL", "minutes": 60, "kcal": 420 }] (ver lib/sports.ts)
  sportsDone         String   @default("[]")
  // Metas vigentes ese día (sin el extra por deporte), para que las estadísticas comparen
  // contra lo que correspondía entonces y no contra la meta actual.
  goalCalories       Float?
  proteinG           Float?
  carbsG             Float?
  fatG               Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([profileId, date])
}

model Food {
  id          String      @id @default(cuid())
  // userId nulo = alimento del catálogo global; con valor = alimento propio del usuario
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  name        String
  category    String
  icon        String
  servingUnit ServingUnit
  foodType    FoodType    @default(CARBOHIDRATOS)
  calories    Float
  protein     Float?
  carbs       Float?
  fat         Float?
  createdAt   DateTime    @default(now())
  entries     FoodEntry[]
  mealItems   MealTemplateItem[]

  @@unique([userId, name])
}

// Comida guardada (plantilla) para cargar varios alimentos de una vez. Ej.: "Desayuno típico".
model MealTemplate {
  id        String             @id @default(cuid())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  icon      String
  // Comida porcionable: cuántas porciones rinde la receta. null = se carga alimento por alimento.
  servings  Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     MealTemplateItem[]

  @@unique([userId, name])
}

model MealTemplateItem {
  id         String       @id @default(cuid())
  template   MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  food       Food         @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId     String
  // Gramos o unidades, según la porción del alimento.
  quantity   Float
  position   Int

  @@index([templateId])
}

model FoodEntry {
  id              String   @id @default(cuid())
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  food            Food?    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId          String?
  mealSlot        MealSlot
  quantity        Float?
  freeDescription String?
  calories        Float
  // Porciones de una comida porcionable (sin foodId; el nombre va en freeDescription).
  // Se guardan los macros e ícono de lo comido para que editar la receta no cambie el historial.
  portions        Float?
  icon            String?
  protein         Float?
  carbs           Float?
  fat             Float?
  date            String
  createdAt       DateTime @default(now())

  @@index([profileId, date])
}
