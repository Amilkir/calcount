{
  "name": "calcount-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply calcount-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply calcount-db --remote",
    "db:seed:sql": "tsx prisma/seed.ts",
    "db:seed:local": "wrangler d1 execute calcount-db --local --file=prisma/seed.sql",
    "db:seed:remote": "wrangler d1 execute calcount-db --remote --file=prisma/seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "next": "^16.4.3",
    "prisma": "^7.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.35.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.154.0"
  }
}
